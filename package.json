{
  "name": "apexwall",
  "version": "2.0.0",
  "description": "ApexWall — Autonomous Sim Racing Telemetry Analytics, Chassis Engineering & Tactical Pit Strategy",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "bridge": "node scripts/telemetry-bridge.js",
    "telemetry-bridge": "node scripts/telemetry-bridge.js",
    "telemetry-bridge:ams2": "node scripts/telemetry-bridge.js --game ams2",
    "telemetry-bridge:forza": "node scripts/telemetry-bridge.js --game forza",
    "telemetry-bridge:f1": "node scripts/telemetry-bridge.js --game f1",
    "telemetry-bridge:acc": "node scripts/telemetry-bridge.js --game acc",
    "telemetry-bridge:acevo": "node scripts/telemetry-bridge.js --game acevo",
    "build:bridge-exe": "esbuild scripts/telemetry-bridge.js --bundle --platform=node --outfile=scripts/bridge-bundle.js && node --experimental-sea-config sea-config.json && node -e \"require('fs').copyFileSync(process.execPath, 'public/downloads/ApexWall-Bridge.exe')\" && postject public/downloads/ApexWall-Bridge.exe NODE_SEA_BLOB sea-prep.blob --sentinel-fuse NODE_SEA_FUSE_fce680ab2cc467b6e072b8b5df1996b2",
    "serve:legacy": "node server.js"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@types/jszip": "^3.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^0.9.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.23.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5"
  }
}
